import "@acton/build"
import "@acton/emulation/config"
import "@acton/emulation/network"
import "@acton/emulation/testing"
import "@acton/testing/expect"

// Every message below is generated by the production TypeScript serializer,
// using public BIP39 test vectors. No private/funded account is used.
fun setupWallet(active: bool, balance: coins = ton("1")): address {
    testing.setNow(1_900_000_000);
    var config = testing.getConfig();
    val implementation = build("Implementation");
    expect(implementation.hash()).toEqual(0xe30911420bef1191c09dce58b9df2b4ca4c2d9c383cc3b6a91170349ffa70e2c);
    config.setParamRaw(-123, implementation);
    expect(testing.setConfig(config)).toBeTrue();
    val stateInit = ContractState {
        code: build("Trampoline"),
        data: build("Data", "fixtures/data.boc"),
    };
    val wallet = AutoDeployAddress { workchain: 0, stateInit }.calculateAddress();
    expect(wallet).toEqual(build("Address", "fixtures/address.boc").beginParse().loadAddress());
    val treasury = testing.treasury("funding");
    if (active) {
        val deployed = net.send(treasury.address, createMessage({
            bounce: false, value: balance, dest: { workchain: 0, stateInit },
        }));
        expect(deployed).toHaveSuccessfulDeploy({ to: wallet });
    } else {
        net.send(treasury.address, createMessage({ bounce: false, value: balance, dest: wallet }));
    }
    return wallet;
}

fun sendFixture(wallet: address, path: string): ExternalSendResult {
    return net.sendExternal({ messageCell: build("Message", path), dest: wallet });
}

fun assertNewKey(wallet: address, path: string, seqno: int): void {
    expect(net.runGetMethod<uint256>(wallet, "get_public_key")).toEqual(build("Key", path).beginParse().loadUint(256));
    expect(net.runGetMethod<uint32>(wallet, "seqno")).toEqual(seqno);
}

get fun `test TS rotation: active wallet, replay, stale key and repeated rotation`() {
    val wallet = setupWallet(true);
    val first = sendFixture(wallet, "fixtures/first.boc");
    expect(first).toBeAccepted();
    expect(first.unwrap()).toHaveSuccessfulTx();
    expect(first.unwrap().at(0).externals.size()).toEqual(1);
    assertNewKey(wallet, "fixtures/nextKey.boc", 1);

    val replay = sendFixture(wallet, "fixtures/first.boc");
    expect(replay).toBeNotAccepted();
    expect(replay).toHaveExternalVmExitCode(135); // current-key signature is checked first
    val stale = sendFixture(wallet, "fixtures/stale.boc");
    expect(stale).toBeNotAccepted();
    expect(stale).toHaveExternalVmExitCode(135);

    val second = sendFixture(wallet, "fixtures/second.boc");
    expect(second).toBeAccepted();
    expect(second.unwrap()).toHaveSuccessfulTx();
    assertNewKey(wallet, "fixtures/thirdKey.boc", 2);
}

get fun `test TS rotation: deploy and rotate the original vanity address`() {
    val wallet = setupWallet(false);
    expect(testing.isDeployed(wallet)).toBeFalse();
    val result = sendFixture(wallet, "fixtures/deploy.boc");
    expect(result).toBeAccepted();
    expect(result.unwrap()).toHaveSuccessfulTx();
    expect(testing.isDeployed(wallet)).toBeTrue();
    assertNewKey(wallet, "fixtures/nextKey.boc", 1);
}

get fun `test TS rotation: insufficient funds cannot deploy or change the key`() {
    val wallet = setupWallet(false, 1);
    val result = sendFixture(wallet, "fixtures/deploy.boc");
    expect(result).toBeNotAccepted();
    expect(testing.isDeployed(wallet)).toBeFalse();
}

get fun `test TS rotation: proof for another address is rejected`() {
    val wallet = setupWallet(true);
    val result = sendFixture(wallet, "fixtures/wrongProof.boc");
    expect(result).toBeNotAccepted();
    expect(result).toHaveExternalVmExitCode(149);
    expect(net.runGetMethod<uint32>(wallet, "seqno")).toEqual(0);
}

get fun `test TS rotation: expired signature is rejected`() {
    val wallet = setupWallet(true);
    testing.setNow(2_000_000_001);
    val result = sendFixture(wallet, "fixtures/first.boc");
    expect(result).toBeNotAccepted();
    expect(result).toHaveExternalVmExitCode(136);
    expect(net.runGetMethod<uint32>(wallet, "seqno")).toEqual(0);
}
